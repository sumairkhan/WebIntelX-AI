# Local Development
APP_NAME=WebIntelX AI
APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./WebIntelXAI.db
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-this-in-development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501
INGESTION_MAX_BATCH_SIZE=50
INGESTION_RATE_LIMIT_PER_MINUTE=60
ML_ENABLED=true
ML_MIN_TRAINING_EVENTS=20
ML_N_ESTIMATORS=100
ML_CONTAMINATION=auto
ML_RANDOM_STATE=42
ML_ANOMALY_THRESHOLD=0.70
ML_MODEL_VERSION=v1
ML_FEATURE_VERSION=v1
ML_MODEL_DIR=data/models
CREWAI_ENABLED=true
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=gsk_your-groq-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
INVESTIGATION_MAX_EVENTS=100
INVESTIGATION_MAX_FINDINGS=50
INVESTIGATION_MAX_CORRELATIONS=50

# Frontend (Next.js) - Set these in frontend/.env.local for local development
# Or set in Vercel dashboard for production
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_WEBINTELX_SDK_URL=http://127.0.0.1:8000/sdk/webintelx.js
# NEXT_PUBLIC_INGESTION_ENDPOINT=http://127.0.0.1:8000/api/ingest/events
