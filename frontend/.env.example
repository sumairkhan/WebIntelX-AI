# Frontend Environment Variables

# Local Development
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_WEBINTELX_SDK_URL=http://127.0.0.1:8000/sdk/webintelx.js
NEXT_PUBLIC_INGESTION_ENDPOINT=http://127.0.0.1:8000/api/ingest/events

# Production (Vercel)
# Set these in Vercel dashboard after Railway backend deployment
# NEXT_PUBLIC_API_URL=https://YOUR-RAILWAY-BACKEND-URL.railway.app
# NEXT_PUBLIC_WEBINTELX_SDK_URL=https://YOUR-RAILWAY-BACKEND-URL.railway.app/sdk/webintelx.js
# NEXT_PUBLIC_INGESTION_ENDPOINT=https://YOUR-RAILWAY-BACKEND-URL.railway.app/api/ingest/events
