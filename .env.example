APP_NAME=WebIntelX AI
APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./WebIntelXAI.db
API_HOST=127.0.0.1
API_PORT=8000
LOG_LEVEL=INFO
JWT_SECRET_KEY=change-this-in-development
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501,https://your-frontend-domain
INGESTION_MAX_BATCH_SIZE=50
INGESTION_RATE_LIMIT_PER_MINUTE=60
CREWAI_ENABLED=true
LLM_PROVIDER=groq
LLM_MODEL=
LLM_API_KEY=your_groq_api_key_here
LLM_BASE_URL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
INVESTIGATION_MAX_EVENTS=100
INVESTIGATION_MAX_FINDINGS=50
INVESTIGATION_MAX_CORRELATIONS=50
